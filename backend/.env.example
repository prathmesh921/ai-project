# UEFA Champions League AI Match Outcome Predictor
# Environment Configuration Template

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Optional Football-Data.org API Integration
# Sign up at https://www.football-data.org/ for a free tier API token (10 requests/min)
# If left blank, the application automatically uses the verified local SQLite fixture schedule.
FOOTBALL_DATA_API_KEY=your_api_key_here

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./ucl_predictor.db
